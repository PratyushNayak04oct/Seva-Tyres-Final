<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml" fx:controller="com.sevatyres.controller.InventoryController" styleClass="page">
    <HBox alignment="CENTER_LEFT" spacing="14">
        <FontIcon iconLiteral="fas-boxes" styleClass="page-title"/>
        <VBox>
            <Label text="Inventory" styleClass="page-title"/>
            <Label text="Manage stock levels and items" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="stockBtn" text="Stock In / Out" styleClass="btn,btn-secondary" onAction="#onStock">
            <graphic><FontIcon iconLiteral="fas-truck"/></graphic>
        </Button>
        <Button fx:id="addItemBtn" text="Add New Item" styleClass="btn" onAction="#onAddItem">
            <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
        </Button>
    </HBox>

    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search items, size, pattern, code..." styleClass="search-box" onKeyReleased="#onSearch"/>
        <Label fx:id="lowStockLabel" styleClass="chip,chip-warning"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol" text="Item" prefWidth="160"/>
            <TableColumn fx:id="skuCol" text="Brand" prefWidth="90"/>
            <TableColumn fx:id="typeCol" text="Type" prefWidth="70"/>
            <TableColumn fx:id="rimCol" text="Rim" prefWidth="55"/>
            <TableColumn fx:id="sizeCol" text="Size" prefWidth="120"/>
            <TableColumn fx:id="patternCol" text="Pattern" prefWidth="100"/>
            <TableColumn fx:id="kindCol" text="TL/TT" prefWidth="55"/>
            <TableColumn fx:id="codeCol" text="Product Code" prefWidth="100"/>
            <TableColumn fx:id="hsnCol" text="HSN/SAC" prefWidth="80"/>
            <TableColumn fx:id="qtyCol" text="Qty" prefWidth="55"/>
            <TableColumn fx:id="priceCol" text="RCP / Price" prefWidth="100"/>
            <TableColumn fx:id="mrpCol" text="MRP" prefWidth="90"/>
            <TableColumn fx:id="billingCol" text="Billing Amount" prefWidth="120"/>
            <TableColumn fx:id="stockCol" text="Status" prefWidth="100"/>
            <TableColumn fx:id="actionCol" text="Actions" minWidth="200" prefWidth="220" sortable="false"/>
        </columns>
    </TableView>
</VBox>

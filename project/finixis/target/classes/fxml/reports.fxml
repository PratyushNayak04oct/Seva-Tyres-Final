<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sevatyres.controller.ReportsController"
            fitToWidth="true" fitToHeight="true" styleClass="scroll-pane" hbarPolicy="NEVER">
    <VBox styleClass="page" prefWidth="960" spacing="20">

        <HBox alignment="CENTER_LEFT" spacing="14">
            <FontIcon iconLiteral="fas-chart-bar" styleClass="page-title"/>
            <VBox>
                <Label text="Reports &amp; Summary" styleClass="page-title"/>
                <Label text="Financial overview, invoice template, and generated files" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Editable invoice template (no file upload) -->
        <VBox styleClass="card,card-pad" spacing="12">
            <Label text="INVOICE TEMPLATE" styleClass="card-title"/>
            <Label text="Edit the invoice layout below. Placeholders are filled from the database when you generate an invoice from Transactions."
                   styleClass="txn-meta" wrapText="true"/>
            <Label text="Placeholders: {company_name} {company_address} {company_contact} {invoice_number} {invoice_date} {due_date} {status} {customer_name} {customer_id} {customer_address} {customer_phone} {customer_email} {items} {subtotal} {tax_label} {tax_amount} {total} {paid} {remaining} {bank_name} {bank_account} {bank_ifsc} {upi_id} {generated_on} {year}"
                   styleClass="text-sm,text-muted" wrapText="true"/>
            <TextArea fx:id="invoiceTemplateArea" wrapText="true" prefRowCount="18" prefHeight="320"
                      styleClass="text-area" promptText="Invoice template text…"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="saveTemplateBtn" text="Save Template" styleClass="btn" onAction="#onSaveTemplate">
                    <graphic><FontIcon iconLiteral="fas-save"/></graphic>
                </Button>
                <Button fx:id="resetTemplateBtn" text="Reset to Default" styleClass="btn,btn-secondary" onAction="#onResetTemplate">
                    <graphic><FontIcon iconLiteral="fas-undo"/></graphic>
                </Button>
                <Label fx:id="templateStatusLabel" styleClass="text-muted"/>
            </HBox>
        </VBox>

        <HBox spacing="16">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="Total Credits" styleClass="stat-label"/>
                <Label fx:id="totalCredits" text="—" styleClass="stat-value,stat-positive"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="Total Payments" styleClass="stat-label"/>
                <Label fx:id="totalDebits" text="—" styleClass="stat-value,stat-negative"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="Net Outstanding" styleClass="stat-label"/>
                <Label fx:id="netLabel" text="—" styleClass="stat-value"/>
            </VBox>
        </HBox>

        <VBox styleClass="card,card-pad" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <FontIcon iconLiteral="fas-folder-open" styleClass="icon-sm"/>
                <Label text="GENERATED FILES" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                <Label text="Click Download to open a generated invoice or report." styleClass="txn-meta"/>
            </HBox>
            <VBox fx:id="filesBox" spacing="6"/>
        </VBox>

    </VBox>
</ScrollPane>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sevatyres.controller.ReportsController"
            fitToWidth="true" fitToHeight="true" styleClass="scroll-pane" hbarPolicy="NEVER">
    <VBox styleClass="page" prefWidth="960" spacing="20">

        <HBox alignment="CENTER_LEFT" spacing="14">
            <FontIcon iconLiteral="fas-chart-bar" styleClass="page-title"/>
            <VBox>
                <Label text="Reports &amp; Summary" styleClass="page-title"/>
                <Label text="Financial overview, invoice template file, and generated files" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox styleClass="card,card-pad" spacing="12">
            <Label text="INVOICE TEMPLATE FILE" styleClass="card-title"/>
            <Label text="Use a professional HTML invoice template. Edit the file in any editor, then upload it here. Transaction data (bill number, customer, items, tax, totals) is filled automatically from the database — do not put live amounts in the file."
                   styleClass="txn-meta" wrapText="true"/>
            <Label text="Placeholders: {company_name} {company_address_line1} {company_city_line} {company_contact} {bill_no} {status} {status_class} {customer_name} {customer_id} {customer_address} {customer_phone} {customer_email} {invoice_date} {due_date} {items_html} {subtotal} {tax_label} {tax_amount} {total} {paid} {remaining} {bank_name} {bank_account} {bank_ifsc} {upi_id} {support_email} {support_phone} {year} {generated_on}"
                   styleClass="text-sm,text-muted" wrapText="true"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="exportTemplateBtn" text="Download Default Template" styleClass="btn,btn-secondary" onAction="#onExportTemplate">
                    <graphic><FontIcon iconLiteral="fas-download"/></graphic>
                </Button>
                <Button fx:id="uploadTemplateBtn" text="Upload Template" styleClass="btn" onAction="#onUploadTemplate">
                    <graphic><FontIcon iconLiteral="fas-upload"/></graphic>
                </Button>
                <Button fx:id="resetTemplateBtn" text="Use Built-in Default" styleClass="btn,btn-ghost" onAction="#onResetTemplate">
                    <graphic><FontIcon iconLiteral="fas-undo"/></graphic>
                </Button>
            </HBox>
            <Label fx:id="templateStatusLabel" text="Using built-in professional HTML template" styleClass="text-muted" wrapText="true"/>
        </VBox>

        <HBox spacing="16">
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="Total Credits" styleClass="stat-label"/>
                <Label fx:id="totalCredits" text="—" styleClass="stat-value,stat-positive"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="Total Payments" styleClass="stat-label"/>
                <Label fx:id="totalDebits" text="—" styleClass="stat-value,stat-negative"/>
            </VBox>
            <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                <Label text="Net Outstanding" styleClass="stat-label"/>
                <Label fx:id="netLabel" text="—" styleClass="stat-value"/>
            </VBox>
        </HBox>

        <VBox styleClass="card,card-pad" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <FontIcon iconLiteral="fas-folder-open" styleClass="icon-sm"/>
                <Label text="GENERATED FILES" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                <Label text="Invoices open as HTML (print to PDF from the browser for a polished bill)." styleClass="txn-meta"/>
            </HBox>
            <VBox fx:id="filesBox" spacing="6"/>
        </VBox>

    </VBox>
</ScrollPane>

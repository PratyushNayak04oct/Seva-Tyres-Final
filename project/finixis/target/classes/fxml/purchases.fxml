<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sevatyres.controller.PurchaseController" styleClass="page">
    <HBox alignment="CENTER_LEFT" spacing="14">
        <FontIcon iconLiteral="fas-shopping-cart" styleClass="page-title"/>
        <VBox>
            <Label text="Purchase Information" styleClass="page-title"/>
            <Label text="Buying prices and dealer price-list columns" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="templateBtn" text="CSV Template" styleClass="btn,btn-secondary" onAction="#onTemplate">
            <graphic><FontIcon iconLiteral="fas-file-csv"/></graphic>
        </Button>
        <Button fx:id="importBtn" text="Import CSV" styleClass="btn,btn-secondary" onAction="#onImport">
            <graphic><FontIcon iconLiteral="fas-file-upload"/></graphic>
        </Button>
        <Button fx:id="addBtn" text="Add Purchase Info" styleClass="btn" onAction="#onAdd">
            <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
        </Button>
    </HBox>

    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search name, size, pattern, code..." styleClass="search-box" onKeyReleased="#onSearch"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol" text="Item" prefWidth="140"/>
            <TableColumn fx:id="brandCol" text="Brand" prefWidth="90"/>
            <TableColumn fx:id="rimCol" text="Rim" prefWidth="50"/>
            <TableColumn fx:id="sizeCol" text="Size" prefWidth="120"/>
            <TableColumn fx:id="patternCol" text="Pattern" prefWidth="100"/>
            <TableColumn fx:id="kindCol" text="TL/TT" prefWidth="55"/>
            <TableColumn fx:id="codeCol" text="Product Code" prefWidth="100"/>
            <TableColumn fx:id="priceCol" text="Buying" prefWidth="90"/>
            <TableColumn fx:id="rcpCol" text="RCP" prefWidth="90"/>
            <TableColumn fx:id="mrpCol" text="MRP" prefWidth="90"/>
            <TableColumn fx:id="notesCol" text="Notes" prefWidth="120"/>
            <TableColumn fx:id="actionCol" text="Actions" minWidth="200" prefWidth="220" sortable="false"/>
        </columns>
    </TableView>
</VBox>

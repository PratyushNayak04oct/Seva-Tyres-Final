<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sevatyres.controller.PurchaseController" styleClass="page">
    <HBox alignment="CENTER_LEFT" spacing="14">
        <FontIcon iconLiteral="fas-shopping-cart" styleClass="page-title"/>
        <VBox>
            <Label text="Purchase Information" styleClass="page-title"/>
            <Label text="Item names and buying prices" styleClass="page-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addBtn" text="Add Purchase Info" styleClass="btn" onAction="#onAdd">
            <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
        </Button>
    </HBox>

    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search by item name..." styleClass="search-box" onKeyReleased="#onSearch"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol" text="Item Name" prefWidth="280"/>
            <TableColumn fx:id="priceCol" text="Buying Price" prefWidth="140"/>
            <TableColumn fx:id="notesCol" text="Notes" prefWidth="220"/>
            <TableColumn fx:id="actionCol" text="Actions" minWidth="200" prefWidth="220" sortable="false"/>
        </columns>
    </TableView>
</VBox>

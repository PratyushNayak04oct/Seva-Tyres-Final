<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sevatyres.controller.CompanyController"
            fitToWidth="true" fitToHeight="true" styleClass="scroll-pane" hbarPolicy="NEVER">
    <VBox styleClass="page" prefWidth="960" spacing="18">

        <HBox alignment="CENTER_LEFT" spacing="14">
            <FontIcon iconLiteral="fas-building" styleClass="page-title"/>
            <VBox>
                <Label text="Company Information" styleClass="page-title"/>
                <Label text="Business profile used on invoices, emails, and SMS identity" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="saveBtn" text="Save Company" styleClass="btn" onAction="#onSave">
                <graphic><FontIcon iconLiteral="fas-save"/></graphic>
            </Button>
        </HBox>

        <VBox styleClass="card,card-pad" spacing="14">
            <Label text="BUSINESS DETAILS" styleClass="card-title"/>
            <GridPane hgap="16" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Company Name *" styleClass="form-label"/>
                    <TextField fx:id="companyNameField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Owner Name" styleClass="form-label"/>
                    <TextField fx:id="ownerNameField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Company Email (alerts / invoices)" styleClass="form-label"/>
                    <TextField fx:id="emailField" promptText="support@company.com" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Contact Number" styleClass="form-label"/>
                    <TextField fx:id="phoneField" promptText="+91 …" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="DBT-enabled Number (SMS)" styleClass="form-label"/>
                    <TextField fx:id="dbtPhoneField" promptText="Number used for SMS / DBT" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="GSTIN" styleClass="form-label"/>
                    <TextField fx:id="gstinField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                    <Label text="Address" styleClass="form-label"/>
                    <TextField fx:id="addressField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="4">
                    <Label text="City" styleClass="form-label"/>
                    <TextField fx:id="cityField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="4">
                    <Label text="State" styleClass="form-label"/>
                    <TextField fx:id="stateField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="5">
                    <Label text="PIN Code" styleClass="form-label"/>
                    <TextField fx:id="pincodeField" styleClass="field"/>
                </VBox>
            </GridPane>
        </VBox>

        <VBox styleClass="card,card-pad" spacing="14">
            <Label text="PAYMENT / BANK DETAILS (shown on invoices)" styleClass="card-title"/>
            <GridPane hgap="16" vgap="12">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Bank Name" styleClass="form-label"/>
                    <TextField fx:id="bankNameField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Account Number" styleClass="form-label"/>
                    <TextField fx:id="bankAccountField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="IFSC Code" styleClass="form-label"/>
                    <TextField fx:id="bankIfscField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="UPI ID" styleClass="form-label"/>
                    <TextField fx:id="upiIdField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                    <Label text="Support Email" styleClass="form-label"/>
                    <TextField fx:id="supportEmailField" styleClass="field"/>
                </VBox>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <Label text="Support Phone" styleClass="form-label"/>
                    <TextField fx:id="supportPhoneField" styleClass="field"/>
                </VBox>
            </GridPane>
            <VBox spacing="4">
                <Label text="About / Notes" styleClass="form-label"/>
                <TextArea fx:id="aboutArea" wrapText="true" prefRowCount="4" styleClass="text-area"/>
            </VBox>
        </VBox>

        <VBox styleClass="card,card-pad" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="IMPORTANT MEMBERS" styleClass="card-title" HBox.hgrow="ALWAYS"/>
                <Button text="Add Member" styleClass="btn,btn-secondary" onAction="#onAddMember">
                    <graphic><FontIcon iconLiteral="fas-user-plus"/></graphic>
                </Button>
            </HBox>
            <TableView fx:id="memberTable" prefHeight="220" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="memberNameCol" text="Name" prefWidth="180"/>
                    <TableColumn fx:id="memberRoleCol" text="Role" prefWidth="140"/>
                    <TableColumn fx:id="memberEmailCol" text="Email" prefWidth="180"/>
                    <TableColumn fx:id="memberPhoneCol" text="Phone" prefWidth="130"/>
                    <TableColumn fx:id="memberActionCol" text="Actions" prefWidth="180" sortable="false"/>
                </columns>
            </TableView>
        </VBox>

        <Label fx:id="statusLabel" styleClass="text-muted"/>
    </VBox>
</ScrollPane>
